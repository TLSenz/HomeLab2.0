# =============================================================================
# VM1 - Core Infrastructure & Media Stack
# IP: 192.168.1.70
# =============================================================================
# Copy this to .env and fill in all values BEFORE running docker compose up

# --- Domain ---
DOMAIN=thethalium.ch

# --- Timezone ---
TZ=Europe/Zurich

# --- NAS / SMB Settings ---
NAS_IP=192.168.1.78
NAS_SHARE_MOVIES=Movies
NAS_SHARE_MUSIC=Music
NAS_SHARE_DOWNLOADS=Downloads
NAS_SHARE_BACKUPS=Backups
NAS_USERNAME=smbuser
NAS_PASSWORD=CHANGE_ME_nas_smb_password

# --- Pi-hole ---
PIHOLE_WEBPASSWORD=CHANGE_ME_pihole_admin_password

# --- Nginx Proxy Manager ---
NPM_ADMIN_EMAIL=admin@thethalium.ch
NPM_ADMIN_PASSWORD=CHANGE_ME_npm_admin_password

# --- Cloudflare Tunnel ---
# Get this from dash.cloudflare.com > Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_cloudflare_tunnel_token

# --- qBittorrent ---
QBITTORRENT_WEBUI_PASSWORD=CHANGE_ME_qbittorrent_password

# --- Cross-VM IPs ---
VM2_IP=192.168.1.71
VM3_IP=192.168.1.73
